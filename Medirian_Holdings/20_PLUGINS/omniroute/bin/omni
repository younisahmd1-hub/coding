#!/bin/sh
# Runs scripts/omni.py with the first working Python 3 (python3, python, or the Windows py launcher).
script="$(cd "$(dirname "$0")/.." && pwd)/scripts/omni.py"
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
    exec "$py" "$script" "$@"
  fi
done
if command -v py >/dev/null 2>&1; then
  exec py -3 "$script" "$@"
fi
echo "omni: Python 3.8+ is required but was not found (Windows: winget install Python.Python.3.13)" >&2
exit 1
